[global]
stonewall
ioengine=page_fault
size=5*1024*1024*$mb_memory/8 # 5/8 of the memory
bs=$pagesize

[page_fault_write]
rw=write

[page_fault_mixed]
rw=randrw
rwmixread=50

[page_fault_process_storm]
size=8*1024*$pagesize
rw=randrw
rwmixread=50
numjobs=$ncpus

[page_fault_mthp]
bsrange=16k-1M
blockalign=2M
rw=write
