[global]
stonewall
size=20g
ioengine=page_fault

[page_fault_process_storm]
size=64M
rw=write
bs=4k
numjobs=20

[page_fault]
rw=write
bs=4k

[page_fault_randwrite]
rw=randwrite
bs=4k

[page_fault_rw]
rw=randrw
rwmixread=50

[page_fault_trim]
rw=trimwrite

[page_fault_mthp]
bsrange=16k-1M
blockalign=2M
rw=write

[page_fault_khugepaged]
rw=write
bs=4k
hugepage_delay=5000

[page_fault_khugepaged_mthp]
bsrange=16k-1M
blockalign=2M
rw=write
bs=4k
hugepage_delay=5000
